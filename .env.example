# MongoDB connection string
MONGODB_URI=

# Secret used to sign session tokens (HMAC). Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Platform super-admin (manages all tenants at admin.<root-domain>).
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

# Optional: serve the super-admin panel at /superadmin on ANY host (not just the
# admin subdomain). Useful where you can't have an admin subdomain, e.g. a
# *.vercel.app URL. Still gated by the super-admin login. Read at BUILD time
# (middleware runs on the edge), so set it before building/deploying.
#   SUPERADMIN_PATH_ACCESS=1
SUPERADMIN_PATH_ACCESS=

# Root domain used to resolve tenants from subdomains.
# Prod: your apex domain (e.g. example.com) → acme.example.com resolves to tenant "acme".
# Local subdomain testing: use lvh.me (resolves *.lvh.me to 127.0.0.1) → acme.lvh.me:3000.
# When unset it falls back to "localhost" (apex → default tenant; acme.localhost works in Chromium).
NEXT_PUBLIC_ROOT_DOMAIN=

# Cloudinary picks these up implicitly via the SDK's default env config
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Machine translation for auto-translating admin-entered content on save.
# Leave unset to disable (content is stored/shown in its source language).
# To enable, point at any LibreTranslate-compatible endpoint (self-hosted or hosted):
#   TRANSLATION_PROVIDER=libretranslate
#   TRANSLATION_URL=http://localhost:5000
#   TRANSLATION_API_KEY=            # optional, if your instance requires one
TRANSLATION_PROVIDER=
TRANSLATION_URL=
TRANSLATION_API_KEY=

# NOTE: admin credentials are now per-tenant and stored (hashed) in the database.
# Create/update a tenant's login with:
#   npm run provision-tenant -- --slug=acme --name="Acme" --username=admin --password='...'
